# =============================================================================
# ChronicCare AI — Local Full-Stack Demo Environment Template
# Target File: backend-poc-technical/.env.localdemo (git-ignored)
# 
# INSTRUCTIONS FOR USMAN:
# 1. Copy this template to backend-poc-technical/.env.localdemo (git-ignored).
# 2. Fill in your actual GROQ_API_KEY, GROQ_MODEL, and FIREBASE_PROJECT_ID.
# 3. Configure DEMO_ROLE_MAP with your designated local provider and admin accounts (format: email:role,email:role).
# 4. DO NOT add MYSQL_URL or MYSQL_SSL_CA (local demo uses pure SQLite).
# =============================================================================

# Application Environment (MUST be 'local' for SQLite; 'production' forces MySQL requirement)
APP_ENV=local

# Database Backend (Strictly SQLite for local demo)
DB_BACKEND=sqlite

# Orchestrator & Interview Engine Configuration
ORCHESTRATOR=graph
INTERVIEW_ENGINE=v2

# Clinical Safety & Risk Model Flags
RISK_ENABLED=true
RISK_CAN_RAISE=true
RISK_PATIENT_VISIBLE=true
RISK_RAISE_COOLDOWN_DAYS=30
TREND_CAN_RAISE=true
NO_READING_SYMPTOM_RAISE=true
DANGER_WORDGROUPS_ENABLED=true

# RAG Explainer Configuration
EXPLAIN_ENABLED=true
EXPLAIN_MODE=background
EXPLAIN_LLM_CONDITIONS=hypertension,diabetes
EXPLAIN_LLM_LANGUAGES=en
LLM_PROVIDER=groq

# OCR Feature Flag
OCR_ENABLED=true

# Screening Interval
SCREENING_REMINDER_INTERVAL_DAYS=90

# Authentication & Access Control
FIREBASE_PROJECT_ID=
DEMO_ROLE_MAP=provider.demo@demo.care:provider,admin.demo@demo.care:admin

# CORS Allowed Origins (Must include local Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Provider Configuration (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# =============================================================================
# Optional: for unattended local_acceptance runs
# =============================================================================
FIREBASE_WEB_API_KEY=
LOCAL_PROVIDER_EMAIL=
LOCAL_PROVIDER_PASSWORD=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=


