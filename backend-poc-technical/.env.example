# Application Environment (optional for dev, 'production' enables production guards)
# Required in production: APP_ENV=production
APP_ENV=

# CORS Configuration (comma-separated origins, no wildcards, trailing slashes removed)
# Required in production (e.g. https://your-app.netlify.app)
CORS_ALLOWED_ORIGINS=

# Database Backend Configuration (sqlite for local dev/CI, mysql required in production)
# Required in production: DB_BACKEND=mysql
DB_BACKEND=
LOCAL_DB_PATH=
# Required in production: MYSQL_URL and MYSQL_SSL_CA
MYSQL_URL=
MYSQL_SSL_CA=

# Auth / Firebase Configuration
# Required in production: FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
DEMO_ROLE_MAP=

# FHIR Server Configuration (optional: overrides default registry fhir_base_url)
FHIR_BASE_URL=
FHIR_PATIENT_ID=

# Groq LLM & Speech-to-Text (STT) Configuration
# GROQ_API_KEY is secret - set only in Render dashboard or local .env (never commit)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Clinical Triage & Inclusion Configuration
REQUIRE_INCLUSION=

# Interview Engine Version: 'v2' (default) or 'v3' (Adaptive Modular Bank Engine)
INTERVIEW_ENGINE=v2


