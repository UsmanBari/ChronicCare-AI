{
  "name": "diabetes_basic_nhanes",
  "dataset": "nhanes_core",
  "split": "nhanes_temporal_v1",
  "label": "diabetes_undiagnosed",
  "population": "adults_without_diabetes",
  "card_population": "told_high_bp_1",
  "tier": "basic",
  "features": [
    "age",
    "sex_male",
    "bmi",
    "ever_smoked_100",
    "told_high_bp"
  ],
  "models": [
    "lr",
    "lr_balanced",
    "rf",
    "hgb"
  ],
  "grid": {
    "lr": {
      "C": [0.01, 0.1, 1.0, 10.0]
    },
    "lr_balanced": {
      "C": [0.01, 0.1, 1.0, 10.0]
    },
    "rf": {
      "n_estimators": [100],
      "max_depth": [5, 10],
      "min_samples_leaf": [10, 50]
    },
    "hgb": {
      "learning_rate": [0.05, 0.1],
      "max_leaf_nodes": [15, 31],
      "min_samples_leaf": [20]
    }
  },
  "threshold_policy": {
    "type": "min_sensitivity",
    "value": 0.80
  },
  "missing": "drop",
  "seed": 42,
  "notes": "Adults without diagnosed diabetes; basic tier profile features (age, sex, BMI, smoking, told high BP)."
}
